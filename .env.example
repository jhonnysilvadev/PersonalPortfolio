# Resend API key. Keep the real value only in .env.local or Vercel.
RESEND_API_KEY=your-resend-api-key

# Destination inbox for contact form submissions.
CONTACT_EMAIL=your-contact-email@example.com

# Verified sender in Resend, for example: Portfolio <noreply@jhonnysilva.pt>
RESEND_FROM_EMAIL=Portfolio <your-verified-sender@example.com>

# Optional read-only token for GitHub API requests.
GITHUB_TOKEN=your-read-only-github-token

# Optional project website links as a JSON object.
PROJECT_DOMAINS={"MusicPreview":"https://musicpreview.jhonnysilva.pt"}

# Public site origin used to validate contact form requests.
SITE_URL=https://your-domain.example

# Upstash Redis REST credentials for contact form rate limiting.
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token